rules_version = '2';

// ════════════════════════════════════════════════════════════════════
// THE SCARLET DIARIES — Firestore Security Rules (V5)
//
// TIER 1 (these rules, works today):
//   Every read/write requires a Firebase Auth session. The app signs in
//   anonymously on launch, so the family is unaffected — but raw API
//   scraping without an auth handshake is blocked, and you can monitor
//   and revoke sessions from the Firebase Console.
//
// TIER 2 (the real fix — see SETUP.md "Going further"):
//   Replace anonymous auth with email/password accounts for the four
//   family members, then replace `isSignedIn()` below with
//   `isFamily()` so ONLY your four accounts can touch the data.
// ════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // TIER 2: uncomment and use instead of isSignedIn() once the four
    // family email accounts exist in Firebase Authentication.
    // function isFamily() {
    //   return request.auth != null &&
    //     request.auth.token.email in [
    //       'mom@example.com',
    //       'dad@example.com',
    //       'tita@example.com',
    //       'amara@example.com'
    //     ];
    // }

    // Family data: settings, logs, foods, badges, alerts, passcodes
    match /families/{familyId}/{document=**} {
      allow read, write: if isSignedIn();
    }

    // Outgoing email queue for the Trigger Email extension.
    // The app only needs to CREATE mail docs — never read or edit them.
    match /mail/{mailId} {
      allow create: if isSignedIn();
      allow read, update, delete: if false;
    }

    // Everything else: denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
